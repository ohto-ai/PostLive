{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-x64",
            "displayName": "Windows x64 (Visual Studio 2022)",
            "description": "Set QT_ROOT to the Qt 5.15.x MSVC 2019 64-bit kit before configuring.",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-x64",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "configurePreset": "windows-x64",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "displayName": "Release",
            "configurePreset": "windows-x64",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "windows-x64",
            "displayName": "Windows x64 tests",
            "configurePreset": "windows-x64",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
