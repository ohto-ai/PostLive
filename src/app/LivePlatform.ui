   <string notr="true">QPushButton#startPushButton
{
	background: rgb(0,160,230);
	border: none;
	border-radius: 6px;
	font-weight: 600;
}
QPushButton#startPushButton:hover
{
	background: rgb(0,180,255);
}
QPushButton#startPushButton:pressed
{
	background: rgb(0,140,200);
}
QPushButton#stopPushButton
{
	background: rgb(192,57,43);
	border: none;
	border-radius: 6px;
	font-weight: 600;
}
QPushButton#stopPushButton:hover
{
	background: rgb(220,80,60);
}
QLabel#titleLabel
{
	color: white;
	font-size: 18px;
	font-weight: 700;
}
QLabel#dockHeader
{
	color: rgb(227,234,242);
	font-weight: 600;
}
QLabel#statusLabel
{
	color: rgb(200,200,200);
}
QToolButton#dockToolButton
{
	border: none;
	border-radius: 4px;
	background: transparent;
	min-width: 28px;
	max-width: 28px;
	min-height: 28px;
	max-height: 28px;
}
QToolButton#dockToolButton:hover
{
	background: rgba(255,255,255,0.18);
}
QToolButton#dockToolButton:pressed
{
	background: rgba(255,255,255,0.30);
}
QToolButton#dockToolButton:disabled
{
	color: rgb(120,120,120);
}

/* tooltip */
QToolTip
{
	color: yellow;
	border: 2px solid #333;
	background-color: black;
}</string>
